# Palantiny Chatbot Server — 예시 환경 변수 (복사 후 `.env`로 저장)
# chatbot_ui.html 테스트 시 MongoDB·Redis·Postgres·Neo4j가 위 URL과 일치해야 합니다.

OPENAI_API_KEY=

DATABASE_URL=postgresql+asyncpg://palantiny:palantiny_secret@localhost:5432/palantiny_db
REDIS_URL=redis://localhost:6379/0

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=palantiny

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=palantiny_secret
NEO4J_DATABASE=neo4j

# 선택: PalantinySettings 단독 스크립트용
SIMILARITY_THRESHOLD=0.75
PALANTINY_MONOGRAPH_GLOB=data/herb_monograph_chapters/**/*.cypher.txt
PALANTINY_HERB_PRICES_CYPHER=data/herb_prices_from_csv.cypher
