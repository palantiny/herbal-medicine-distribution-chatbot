# EC2에 .env.prod 파일로 복사 후 실제 값으로 채우세요
# 이 파일은 예시용이며 git에 올라갑니다

# PostgreSQL
POSTGRES_USER=palantiny
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=palantiny_db

# Neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_strong_neo4j_password_here

# OpenAI
OPENAI_API_KEY=sk-...

# CORS (프론트엔드 도메인, 예: https://example.com)
ALLOWED_ORIGINS=https://your-domain.com

# AWS (DynamoDB 채팅 히스토리용)
# EC2 IAM Role이 DynamoDB 권한을 갖고 있다면 아래 두 줄 비워도 됩니다
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=ap-northeast-2
DYNAMODB_TABLE_CHAT=palantiny-chat-history
